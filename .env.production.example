# 复制成 .env.production 后按实际环境修改，.env.production 不提交到 git
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
# 部署在 Nginx 后面填 1；前面还有七层 CLB 就填 2
TRUST_PROXY=1

# 本地 docker compose 用 compose 里的 redis；ECS 上改成云 Redis 的内网地址，有密码写成 redis://:密码@地址:6379/0
REDIS_URL=redis://redis:6379/0

AUTH_JWKS_URL=http://mock:4004/.well-known/jwks.json
AUTH_ISSUER=buz-auth
AUTH_AUDIENCE=buz-bff

# 没有真实下游服务，先指向 compose 里的 mock
ORDER_SERVICE_URL=http://mock:4001
PRODUCT_SERVICE_URL=http://mock:4002
AD_SERVICE_URL=http://mock:4003
