NODE_ENV=development
PORT=3001
# 本地开发用 debug，能看到缓存命中等细节；线上用 info
LOG_LEVEL=debug

# 有密码时写成 redis://:密码@地址:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# 认证服务的公钥地址，以及 token 里必须匹配的签发方和接收方
AUTH_JWKS_URL=http://127.0.0.1:4004/.well-known/jwks.json
AUTH_ISSUER=buz-auth
AUTH_AUDIENCE=buz-bff

# 下游服务地址，本地开发指向 mock 服务
ORDER_SERVICE_URL=http://127.0.0.1:4001
PRODUCT_SERVICE_URL=http://127.0.0.1:4002
AD_SERVICE_URL=http://127.0.0.1:4003
